# Copie para ".env" só se for rodar no seu computador (npm run dev).
# Na Vercel, cadastre essas duas variáveis em Settings → Environment Variables.

# Neon → seu projeto → Connect → "Connection string" (com "Connection pooling" ligado)
DATABASE_URL="postgresql://neondb_owner:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Texto aleatório com 40+ caracteres (gere em https://generate-secret.vercel.app/64)
AUTH_SECRET="troque-por-um-texto-aleatorio-bem-grande-1234567890"
